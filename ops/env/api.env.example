NODE_ENV=production
HOST=127.0.0.1
PORT=8080
TRUST_PROXY=true
PANEL_ORIGIN=https://panel.legacyhosting.xyz
DATABASE_URL=mysql://USER:PASSWORD@HOST:25060/legacyhosting?ssl-mode=VERIFY_IDENTITY
DATABASE_SSL_CA=/etc/ssl/certs/digitalocean-mysql-ca.pem
SESSION_COOKIE_DOMAIN=.legacyhosting.xyz
SESSION_TTL_DAYS=30
WEBAUTHN_RP_NAME='Legacy Hosting'
WEBAUTHN_RP_ID=legacyhosting.xyz
WEBAUTHN_ORIGIN=https://panel.legacyhosting.xyz
INITIAL_ADMIN_TOKEN=GENERATE_AND_REMOVE_AFTER_BOOTSTRAP
CREDENTIAL_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
CSRF_SECRET=AT_LEAST_32_RANDOM_CHARACTERS
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
ALLOW_LEGACY_AGENT_SIGNATURES=true
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_REDIRECT_URI=https://api.legacyhosting.xyz/api/v1/integrations/cloudflare/callback
CLOUDFLARE_OAUTH_API_ORIGIN=https://api.cloudflare.com
CLOUDFLARE_OAUTH_TOKEN_AUTH_METHOD=client_secret_basic
CLOUDFLARE_OAUTH_SCOPES='dns.read dns.write zone.read user-details.read offline_access'
ACME_EMAIL=angel@legacyhosting.xyz
CERTIFICATE_RENEWAL_DAYS=30
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_VERSION=2026-03-10
MONITORING_INTERVAL_MS=30000
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@legacyhosting.xyz
